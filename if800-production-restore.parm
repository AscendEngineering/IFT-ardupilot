# IF800 production param restore  --  corrects SIH contamination in if800-param-backup-2026-07-15.parm
# Board: CubeOrangePlus 2D0018000551333233343437, production 4.5.6.2 firmware already flashed,
# contaminated backup already loaded. Load this file ON TOP, reboot, then load it a SECOND time
# (BATT_*/CAM1_* subtree params only exist after their enable params take effect), reboot again.
#
# Sources: sister-vehicle export ift_orginal_params.param + git-original production section of
# IF800-CubeOrangePlus/defaults.parm (pre-SIH edits). Per-vehicle cals NOT touched.

# ---- SIH-contaminated values -> production ----
AHRS_EKF_TYPE,3  # SIH AHRS (10) -> EKF3
GPS_TYPE,9  # SIH GPS (100) -> DroneCAN (git-original prod value)
GPS_TYPE2,9  # SIH zeroed it -> DroneCAN GPS2 (git-original prod value)
SERIAL3_PROTOCOL,2  # SIH GPS-on-serial (5) -> MAVLink2 (git-original prod value)
BATT_MONITOR,8  # SIH disabled -> DroneCAN battery
BATT2_MONITOR,8  # SIH disabled -> DroneCAN battery
BRD_HEAT_TARG,45  # SIH lowered to 25 -> IMU heater back to 45
BRD_RTC_TYPES,1  # SIH mavlink-time (2) -> GPS time
FLTMODE_CH,5  # SIH moved to ch7 -> ch5 (sister vehicle / firmware default)
MNT1_PITCH_MIN,-89  # SIH widened to -90 -> production Gremsy limit
MNT1_YAW_MIN,-180  # SIH widened to -319 -> production limit
MNT1_YAW_MAX,180  # SIH widened to 319 -> production limit
INS_ACC3_ID,3015690  # zeroed during SIH debug; relinks THIS board's stored ACC3 cal (id from sister, same hw)
INS_GYR3_ID,3015690  # same
CAM1_TYPE,5  # hidden under SIH (CAM1 subtree absent) -> sister operational value
CAM2_TYPE,0  # SIH MAVLinkCamV2 (6) -> sister has camera on CAM1 not CAM2 (repo git-original said 5 here — VERIFY fleet convention)

